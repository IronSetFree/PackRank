{
  "name": "packrank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PackRank — WARDOGS player stats, global rankings, and Discord community leaderboards.",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "commands:deploy": "tsx src/register-commands.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "steam:probe": "tsx src/tools/probe-steam.ts",
    "railway:build": "npm run build",
    "railway:predeploy": "npm run db:deploy && npm run commands:deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "discord.js": "14.27.0",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
