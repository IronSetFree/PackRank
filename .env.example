# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set this while developing to deploy commands instantly to one guild.
# Leave blank to deploy global commands.
DISCORD_GUILD_ID=

# PostgreSQL
DATABASE_URL=postgresql://wardogs:wardogs@localhost:5432/wardogs?schema=public

# Data provider: mock | steam | http
WARDOGS_PROVIDER=mock

# Steam provider (documented Valve Web API)
# Create a Steam Web API user key and keep it server-side/private.
STEAM_API_KEY=
WARDOGS_STEAM_APP_ID=1867240

# Optional exact Steam stat names. Run `npm run steam:probe -- <SteamID64>`
# to discover what WARDOGS actually publishes. Common names are auto-detected.
WARDOGS_STEAM_STAT_LEVEL=
WARDOGS_STEAM_STAT_XP=
WARDOGS_STEAM_STAT_CASH=
WARDOGS_STEAM_STAT_WORTH=
WARDOGS_STEAM_STAT_GOLD=
WARDOGS_STEAM_STAT_UNLOCKS=
WARDOGS_STEAM_STAT_KILLS=
WARDOGS_STEAM_STAT_DEATHS=
WARDOGS_STEAM_STAT_MATCHES=
WARDOGS_STEAM_STAT_WINS=
WARDOGS_STEAM_STAT_ASSAULT=
WARDOGS_STEAM_STAT_MEDIC=
WARDOGS_STEAM_STAT_RECON=
WARDOGS_STEAM_STAT_SUPPORT=
WARDOGS_STEAM_STAT_DRIVER=
WARDOGS_STEAM_STAT_PILOT=
WARDOGS_STEAM_STAT_XPMIN=
WARDOGS_STEAM_STAT_CASHMIN=

# Generic authorized HTTP provider
WARDOGS_API_BASE_URL=
WARDOGS_API_TOKEN=

# How often linked players are refreshed.
SYNC_INTERVAL_MINUTES=15
WARDOGS_SEASON=Season 01
