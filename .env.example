# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set this while developing to deploy commands instantly to one guild.
# Leave blank to deploy global commands.
DISCORD_GUILD_ID=

# PostgreSQL
DATABASE_URL=postgresql://wardogs:wardogs@localhost:5432/wardogs?schema=public

# Data provider. "mock" works immediately for local development.
# Change to "http" when an authorized WARDOGS API becomes available.
WARDOGS_PROVIDER=mock
WARDOGS_API_BASE_URL=
WARDOGS_API_TOKEN=

# How often linked players are refreshed.
SYNC_INTERVAL_MINUTES=15
WARDOGS_SEASON=Season 01
