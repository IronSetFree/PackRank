generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model WardogsPlayer {
  id               BigInt             @id @default(autoincrement())
  providerPlayerId String             @unique
  displayName      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  links            DiscordLink[]
  snapshots        StatSnapshot[]
  globalRanks      GlobalRank[]
  trackedBy        TrackListMember[]

  @@index([displayName])
}

model DiscordLink {
  id            BigInt         @id @default(autoincrement())
  guildId       String
  discordUserId String
  playerId      BigInt
  linkedAt      DateTime       @default(now())
  player        WardogsPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordUserId])
  @@unique([guildId, playerId])
  @@index([playerId])
}

model TrackList {
  id                 BigInt             @id @default(autoincrement())
  guildId            String
  ownerDiscordUserId String
  name               String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  members            TrackListMember[]

  @@unique([guildId, ownerDiscordUserId, name])
  @@index([guildId, ownerDiscordUserId])
}

model TrackListMember {
  id       BigInt        @id @default(autoincrement())
  listId   BigInt
  playerId BigInt
  addedAt  DateTime      @default(now())
  list     TrackList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  player   WardogsPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([listId, playerId])
  @@index([playerId])
}

model StatSnapshot {
  id               BigInt         @id @default(autoincrement())
  playerId         BigInt
  season           String
  capturedAt       DateTime       @default(now())

  playtimeMinutes  Int?
  wardogLevel      Int?
  totalXp          BigInt?
  cash             BigInt?
  accountWorth     BigInt?
  gold             Int?
  unlocks          Int?

  kills            BigInt?
  deaths           BigInt?
  matches          Int?
  wins             Int?

  assaultLevel     Int?
  medicLevel       Int?
  reconLevel       Int?
  supportLevel     Int?
  driverLevel      Int?
  pilotLevel       Int?

  xpPerMinute      Float?
  cashPerMinute    Float?

  player           WardogsPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, capturedAt(sort: Desc)])
  @@index([season, capturedAt(sort: Desc)])
}

model GlobalRank {
  id           BigInt         @id @default(autoincrement())
  playerId     BigInt
  season       String
  metric       String
  rank         Int
  totalPlayers Int?
  source       String
  asOf         DateTime
  player       WardogsPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, metric, source])
  @@index([season, metric, rank])
}
